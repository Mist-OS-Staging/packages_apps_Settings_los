<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mist_color_ripple">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners
                android:topLeftRadius="3dp"
                android:bottomLeftRadius="28dp"
                android:topRightRadius="3dp"
                android:bottomRightRadius="3dp" />
        </shape>
    </item>
    <item id="@android:id/background">
        <shape
            android:tint="@color/mist_color_primary_accent_a30"
            android:shape="rectangle"
            android:tintMode="src_atop">
            <gradient
                android:startColor="@color/mist_color_primary_accent_dark"
                android:endColor="@android:color/system_accent1_500"
                android:angle="270"/>
            <corners
                android:topLeftRadius="3dp"
                android:bottomLeftRadius="28dp"
                android:topRightRadius="3dp"
                android:bottomRightRadius="3dp" />
            <stroke
                android:width="3dp"
                android:color="#1A000000" />
        </shape>
    </item>
</ripple>
