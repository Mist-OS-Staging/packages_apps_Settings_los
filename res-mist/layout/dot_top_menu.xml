<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mist_card"
    android:id="@+id/dot_top_menu_preference_layout"
    android:layout_gravity="center"
    android:gravity="center"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginTop="36dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="?android:attr/listPreferredItemPaddingEnd"
    android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="82dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp"
        android:background="@drawable/dot_top_menu_about_background"
        android:clipToPadding="false"
        android:baselineAligned="false"
        android:divider="3dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:layout_marginEnd="0dp">

            <androidx.preference.internal.PreferenceImageView
                android:id="@+id/avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_about_device_filled"/>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="@dimen/homepage_preference_text_padding_start"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/about_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_settings"
                style="@style/MistPreferenceTitle"/>

            <TextView
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/about_title"
                android:layout_alignStart="@id/about_title"
                android:text="@string/summary_placeholder"
                style="@style/MistPreferenceSummary"/>
        </RelativeLayout>

        <include layout="@layout/layout_chevron"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_gravity="center"
        app:cardCornerRadius="4dp"
        app:cardElevation="6dp"
        android:backgroundTint="#30000000" />

    <LinearLayout
        android:id="@+id/mist_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="82dp"
        android:gravity="center_vertical"
        android:background="@drawable/dot_top_menu_mist_background"
        android:clipToPadding="false"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:layout_marginEnd="0dp">

            <androidx.preference.internal.PreferenceImageView
                android:id="@+id/avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_about_device_filled"/>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="@dimen/homepage_preference_text_padding_start"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mist_dashboard_title"
                style="@style/MistPreferenceTitle"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/settings_title"
                android:layout_alignStart="@id/settings_title"
                android:text="@string/mist_dashboard_summary"
                style="@style/MistPreferenceSummary"/>
        </RelativeLayout>

        <include layout="@layout/layout_chevron"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_gravity="center"
        app:cardCornerRadius="4dp"
        app:cardElevation="6dp"
        android:backgroundTint="#30000000" />

    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:padding="0dp">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/wifi"
            android:background="@drawable/nad_top_menu_wifi_bg"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp">

            <androidx.preference.internal.PreferenceImageView
                android:id="@+id/wifi_icon"
                android:background="@android:color/transparent"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_top_menu_wifi"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
            <TextView
                android:id="@+id/wifi_title"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/network_dashboard_title"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                style="@style/MistPreferenceSmallTitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/battery"
            android:background="@drawable/nad_top_menu_battery_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp">
            <androidx.preference.internal.PreferenceImageView
                android:id="@+id/battery_icon"
                android:background="@android:color/transparent"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_top_menu_battery"
                android:scaleType="centerInside"
                android:rotation="90"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/battery_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/power_usage_summary_title"
                    style="@style/MistPreferenceSmallTitle"/>

                <TextView
                    android:id="@+id/battery_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/battery_title"
                    android:layout_alignStart="@id/battery_title"
                    style="@style/MistPreferenceSmallSummary"/>
            </RelativeLayout>
        </LinearLayout>
</LinearLayout>
